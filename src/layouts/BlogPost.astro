---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import FormattedDate from '../components/FormattedDate.astro'
import BaseLayout from './BaseLayout.astro'

interface Props {
  title: string
  description?: string
  date?: Date
  heroImage?: ImageMetadata
}

const { title, description, date, heroImage } = Astro.props
---

<BaseLayout title={title} description={description} image={heroImage}>
  <article>
    <header class="space-y-1 border-b border-neutral-200 pb-10 text-center dark:border-neutral-700">
      {date && (
        <dl>
          <dt class="sr-only">發佈於</dt>
          <dd class="text-base leading-6 font-medium text-neutral-500 dark:text-neutral-400">
            <FormattedDate date={date} />
          </dd>
        </dl>
      )}
      <h1 class="text-3xl leading-9 font-extrabold tracking-tight text-neutral-900 sm:text-4xl sm:leading-10 md:text-5xl md:leading-14 dark:text-neutral-100">
        {title}
      </h1>
    </header>
    {heroImage && <Image src={heroImage} width={1020} alt="" class="mt-10 w-full rounded-lg" />}
    <div class="prose max-w-none pt-10 pb-8 prose-neutral dark:prose-invert">
      <slot />
    </div>
  </article>
</BaseLayout>
