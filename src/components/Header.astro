---
import Logo from '../assets/logo.svg'
import { SITE_TITLE } from '../consts'
import ThemeSwitch from './ThemeSwitch.astro'

const links = [
  { href: '/posts/', title: 'Posts' },
  { href: '/tags/', title: 'Tags' },
  { href: '/about/', title: 'About' },
]
---

<header class="flex items-center justify-between py-10">
  <a href="/" aria-label={SITE_TITLE} class="flex items-center">
    <Logo class="mr-3 h-12 w-12" />
    <span class="hidden text-2xl font-semibold sm:block">{SITE_TITLE}</span>
  </a>
  <nav class="flex items-center text-base leading-5">
    {links.map((link) => (
      <a href={link.href} class="p-1 font-medium text-neutral-900 sm:p-4 dark:text-neutral-100">
        {link.title}
      </a>
    ))}
    <ThemeSwitch />
  </nav>
</header>
