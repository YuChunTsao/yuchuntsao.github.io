---
import { AUTHOR, GITHUB, SITE_TITLE } from '../consts'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title={`About - ${SITE_TITLE}`}>
  <div class="divide-y divide-neutral-200 dark:divide-neutral-700">
    <div class="space-y-2 pt-6 pb-8 md:space-y-5">
      <h1 class="text-3xl leading-9 font-extrabold tracking-tight text-neutral-900 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14 dark:text-neutral-100">
        About
      </h1>
    </div>
    <div class="items-start space-y-2 xl:grid xl:grid-cols-3 xl:space-y-0 xl:gap-x-8">
      <div class="flex flex-col items-center pt-8">
        <img src="/static/images/avatar.png" alt={AUTHOR} class="h-48 w-48 rounded-full" />
        <h2 class="pt-4 pb-2 text-2xl leading-8 font-bold tracking-tight">{AUTHOR}</h2>
        <a
          href={GITHUB}
          class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
        >
          GitHub
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
