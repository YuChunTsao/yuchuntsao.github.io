---
import Tag from '../../components/Tag.astro'
import { SITE_TITLE } from '../../consts'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getTags } from '../../lib/posts'

const tags = await getTags()
---

<BaseLayout title={`Tags - ${SITE_TITLE}`}>
  <div class="flex flex-col items-start justify-start divide-y divide-neutral-200 md:mt-24 md:flex-row md:items-center md:justify-center md:space-x-6 md:divide-y-0 dark:divide-neutral-700">
    <div class="space-x-2 pt-6 pb-8 md:space-y-5">
      <h1 class="text-3xl leading-9 font-extrabold tracking-tight text-neutral-900 sm:text-4xl sm:leading-10 md:border-r-2 md:px-6 md:text-6xl md:leading-14 dark:text-neutral-100">
        Tags
      </h1>
    </div>
    <div class="flex max-w-lg flex-wrap">
      {tags.length === 0 && '還沒有標籤。'}
      {tags.map(([tag, count]) => (
        <div class="mt-2 mr-5 mb-2">
          <Tag text={tag} />
          <a
            href={`/tags/${tag}/`}
            class="-ml-2 text-sm font-semibold text-neutral-600 uppercase dark:text-neutral-300"
          >
            ({count})
          </a>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
